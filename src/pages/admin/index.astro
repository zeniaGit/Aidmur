---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAdminSession } from '../../lib/auth';
import { getAllPosts } from '../../lib/posts';

export const prerender = false;

const session = await getAdminSession(Astro.request);
if (!session.authenticated) {
  return Astro.redirect('/admin/login');
}

const allPosts = getAllPosts(true);
const customPosts = allPosts.filter(p => p.id > 1907 || p.created_at);

function formatDate(dateStr: string) {
  if (!dateStr) return '';
  const d = new Date(dateStr);
  return d.toLocaleDateString('es-ES', {
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });
}
---

<AdminLayout title="Panel de Gestión de Comunicados - AIDMUR" username={session.username}>
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h1 style="font-size: 1.85rem; font-weight: 800; color: #0f172a; margin-bottom: 0.35rem;">
        Gestión de Comunicados
      </h1>
      <p style="color: #64748b; font-size: 0.95rem;">
        Crea, edita y organiza las notas de prensa y comunicados de AIDMUR.
      </p>
    </div>
    <div>
      <a href="/admin/nuevo" class="btn btn-primary" style="padding: 0.75rem 1.35rem; font-size: 0.95rem; box-shadow: 0 4px 12px rgba(5, 150, 105, 0.25);">
        <span>➕</span> Redactar Nuevo Comunicado
      </a>
    </div>
  </div>

  <!-- Metric Badges -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; margin-bottom: 2rem;">
    <div class="card" style="padding: 1.25rem;">
      <div style="font-size: 0.8rem; font-weight: 700; color: #64748b; text-transform: uppercase; margin-bottom: 0.35rem;">
        Total Comunicados
      </div>
      <div style="font-size: 1.85rem; font-weight: 800; color: #0f172a;">
        {allPosts.length}
      </div>
    </div>

    <div class="card" style="padding: 1.25rem;">
      <div style="font-size: 0.8rem; font-weight: 700; color: #64748b; text-transform: uppercase; margin-bottom: 0.35rem;">
        Publicados desde Panel
      </div>
      <div style="font-size: 1.85rem; font-weight: 800; color: #059669;">
        {customPosts.length}
      </div>
    </div>

    <div class="card" style="padding: 1.25rem;">
      <div style="font-size: 0.8rem; font-weight: 700; color: #64748b; text-transform: uppercase; margin-bottom: 0.35rem;">
        Borradores
      </div>
      <div style="font-size: 1.85rem; font-weight: 800; color: #f59e0b;">
        {allPosts.filter(p => p.is_draft).length}
      </div>
    </div>
  </div>

  <!-- Posts Table Card -->
  <div class="card" style="padding: 0; overflow: hidden;">
    <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid #e2e8f0; background: #fafafa; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
      <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
        <h2 style="font-size: 1.1rem; font-weight: 700; color: #0f172a;">
          Lista de Comunicados
        </h2>
        <span id="pagination-info-top" style="font-size: 0.82rem; color: #64748b; background: #f1f5f9; padding: 0.2rem 0.6rem; border-radius: 6px;">
          Cargando...
        </span>
      </div>

      <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
        <div style="display: flex; align-items: center; gap: 0.35rem;">
          <label for="per-page-select" style="font-size: 0.82rem; color: #64748b; font-weight: 600;">Ver:</label>
          <select id="per-page-select" style="padding: 0.35rem 0.6rem; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.82rem; outline: none; background: white;">
            <option value="20" selected>20 por pág.</option>
            <option value="50">50 por pág.</option>
            <option value="100">100 por pág.</option>
            <option value="300">Todos</option>
          </select>
        </div>

        <input 
          type="text" 
          id="search-table" 
          placeholder="Buscar por título..." 
          style="padding: 0.45rem 0.85rem; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.88rem; outline: none; width: 220px;"
        />
      </div>
    </div>

    <div style="overflow-x: auto;">
      <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;" id="posts-table">
        <thead>
          <tr style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #64748b; font-weight: 700; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em;">
            <th style="padding: 0.85rem 1.25rem;">Título</th>
            <th style="padding: 0.85rem 1rem;">Categorías</th>
            <th style="padding: 0.85rem 1rem;">Fecha y Hora</th>
            <th style="padding: 0.85rem 1rem;">Estado</th>
            <th style="padding: 0.85rem 1.25rem; text-align: right;">Acciones</th>
          </tr>
        </thead>
        <tbody style="divide-y: 1px solid #f1f5f9;" id="posts-tbody">
          {allPosts.map((post) => (
            <tr class="post-row" style="border-bottom: 1px solid #f1f5f9; transition: background 0.1s ease;" onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background='white'">
              <td style="padding: 1rem 1.25rem; max-width: 420px;">
                <div style="font-weight: 700; color: #0f172a; line-height: 1.35; margin-bottom: 0.25rem;" class="post-title">
                  {post.title}
                </div>
                <div style="font-size: 0.78rem; color: #94a3b8;">
                  Slug: /{post.slug}
                </div>
              </td>
              <td style="padding: 1rem;">
                <div style="display: flex; flex-wrap: wrap; gap: 0.35rem;">
                  {post.categories?.map((cat) => (
                    <span style="background: #f1f5f9; color: #475569; font-size: 0.75rem; font-weight: 600; padding: 0.15rem 0.45rem; border-radius: 4px;">
                      {cat.name}
                    </span>
                  ))}
                </div>
              </td>
              <td style="padding: 1rem; color: #475569; font-size: 0.85rem; white-space: nowrap;">
                {formatDate(post.date)}
              </td>
              <td style="padding: 1rem; white-space: nowrap;">
                {post.is_draft ? (
                  <span style="background: #fef3c7; color: #92400e; font-size: 0.75rem; font-weight: 700; padding: 0.2rem 0.5rem; border-radius: 6px; border: 1px solid #fde68a;">
                    Borrador
                  </span>
                ) : (
                  <span style="background: #ecfdf5; color: #065f46; font-size: 0.75rem; font-weight: 700; padding: 0.2rem 0.5rem; border-radius: 6px; border: 1px solid #a7f3d0;">
                    Publicado
                  </span>
                )}
              </td>
              <td style="padding: 1rem 1.25rem; text-align: right; white-space: nowrap;">
                <div style="display: inline-flex; gap: 0.5rem;">
                  <a 
                    href={`/articulo/${post.slug}`} 
                    target="_blank" 
                    class="btn btn-outline" 
                    style="padding: 0.35rem 0.65rem; font-size: 0.8rem;"
                    title="Ver en la web"
                  >
                    👁️ Ver
                  </a>
                  <a 
                    href={`/admin/editar/${post.id}`} 
                    class="btn btn-outline" 
                    style="padding: 0.35rem 0.65rem; font-size: 0.8rem; color: #059669; border-color: #a7f3d0;"
                    title="Editar comunicado"
                  >
                    ✏️ Editar
                  </a>
                  {post.id > 1907 && (
                    <button 
                      type="button" 
                      class="btn btn-danger-outline delete-btn" 
                      data-id={post.id}
                      data-title={post.title}
                      style="padding: 0.35rem 0.65rem; font-size: 0.8rem;"
                      title="Eliminar comunicado"
                    >
                      🗑️
                    </button>
                  )}
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Pagination Controls Footer -->
    <div style="padding: 1rem 1.5rem; border-top: 1px solid #e2e8f0; background: #fafafa; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <div id="pagination-info" style="font-size: 0.85rem; color: #64748b;">
        Mostrando comunicados
      </div>

      <div style="display: flex; align-items: center; gap: 0.4rem;">
        <button type="button" id="first-page-btn" class="btn btn-outline" style="padding: 0.35rem 0.65rem; font-size: 0.82rem;">
          « Primera
        </button>
        <button type="button" id="prev-page-btn" class="btn btn-outline" style="padding: 0.35rem 0.65rem; font-size: 0.82rem;">
          ‹ Anterior
        </button>
        <span id="page-indicator" style="font-size: 0.85rem; font-weight: 700; color: #0f172a; padding: 0 0.5rem;">
          Página 1 de 1
        </span>
        <button type="button" id="next-page-btn" class="btn btn-outline" style="padding: 0.35rem 0.65rem; font-size: 0.82rem;">
          Siguiente ›
        </button>
        <button type="button" id="last-page-btn" class="btn btn-outline" style="padding: 0.35rem 0.65rem; font-size: 0.82rem;">
          Última »
        </button>
      </div>
    </div>
  </div>

  <script>
    const searchInput = document.getElementById('search-table') as HTMLInputElement;
    const perPageSelect = document.getElementById('per-page-select') as HTMLSelectElement;
    const rows = Array.from(document.querySelectorAll('.post-row')) as HTMLTableRowElement[];
    
    const prevBtn = document.getElementById('prev-page-btn') as HTMLButtonElement;
    const nextBtn = document.getElementById('next-page-btn') as HTMLButtonElement;
    const firstBtn = document.getElementById('first-page-btn') as HTMLButtonElement;
    const lastBtn = document.getElementById('last-page-btn') as HTMLButtonElement;
    const pageIndicator = document.getElementById('page-indicator') as HTMLElement;
    const paginationInfo = document.getElementById('pagination-info') as HTMLElement;
    const paginationInfoTop = document.getElementById('pagination-info-top') as HTMLElement;

    let currentPage = 1;
    let itemsPerPage = parseInt(perPageSelect.value, 10) || 20;
    let filteredRows = [...rows];

    function updatePagination() {
      const totalItems = filteredRows.length;
      const totalPages = Math.max(1, Math.ceil(totalItems / itemsPerPage));

      if (currentPage > totalPages) {
        currentPage = totalPages;
      }
      if (currentPage < 1) {
        currentPage = 1;
      }

      const startIndex = (currentPage - 1) * itemsPerPage;
      const endIndex = Math.min(startIndex + itemsPerPage, totalItems);

      // Hide all rows first
      rows.forEach(r => (r.style.display = 'none'));

      // Show only current page items that are in filteredRows
      for (let i = startIndex; i < endIndex; i++) {
        if (filteredRows[i]) {
          filteredRows[i].style.display = '';
        }
      }

      // Update indicators
      const textInfo = totalItems > 0 
        ? `Mostrando ${startIndex + 1} - ${endIndex} de ${totalItems} comunicados`
        : '0 comunicados encontrados';

      if (paginationInfo) paginationInfo.textContent = textInfo;
      if (paginationInfoTop) paginationInfoTop.textContent = textInfo;
      if (pageIndicator) pageIndicator.textContent = `Página ${currentPage} de ${totalPages}`;

      // Button states
      if (firstBtn) firstBtn.disabled = currentPage === 1;
      if (prevBtn) prevBtn.disabled = currentPage === 1;
      if (nextBtn) nextBtn.disabled = currentPage === totalPages || totalItems === 0;
      if (lastBtn) lastBtn.disabled = currentPage === totalPages || totalItems === 0;
    }

    // Filter rows by search
    function applySearch() {
      const q = searchInput.value.toLowerCase().trim();
      if (!q) {
        filteredRows = [...rows];
      } else {
        filteredRows = rows.filter(row => {
          const title = row.querySelector('.post-title')?.textContent?.toLowerCase() || '';
          return title.includes(q);
        });
      }
      currentPage = 1;
      updatePagination();
    }

    searchInput?.addEventListener('input', applySearch);

    perPageSelect?.addEventListener('change', () => {
      itemsPerPage = parseInt(perPageSelect.value, 10) || 20;
      currentPage = 1;
      updatePagination();
    });

    prevBtn?.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        updatePagination();
        window.scrollTo({ top: 200, behavior: 'smooth' });
      }
    });

    nextBtn?.addEventListener('click', () => {
      const totalPages = Math.ceil(filteredRows.length / itemsPerPage);
      if (currentPage < totalPages) {
        currentPage++;
        updatePagination();
        window.scrollTo({ top: 200, behavior: 'smooth' });
      }
    });

    firstBtn?.addEventListener('click', () => {
      currentPage = 1;
      updatePagination();
      window.scrollTo({ top: 200, behavior: 'smooth' });
    });

    lastBtn?.addEventListener('click', () => {
      currentPage = Math.ceil(filteredRows.length / itemsPerPage);
      updatePagination();
      window.scrollTo({ top: 200, behavior: 'smooth' });
    });

    // Initial render
    updatePagination();

    // Delete post handler
    const deleteButtons = document.querySelectorAll('.delete-btn');
    deleteButtons.forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        const title = btn.getAttribute('data-title');
        if (!id) return;

        if (confirm(`¿Estás seguro de que deseas eliminar el comunicado "${title}"?`)) {
          try {
            const res = await fetch(`/api/comunicados/${id}`, { method: 'DELETE' });
            const data = await res.json();
            if (res.ok && data.success) {
              window.location.reload();
            } else {
              alert(data.error || 'Error al eliminar el comunicado');
            }
          } catch (err) {
            alert('Error de conexión al intentar eliminar');
          }
        }
      });
    });
  </script>
</AdminLayout>
