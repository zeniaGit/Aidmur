---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada - AIDMUR">
  <div class="container" style="padding: 6rem 1rem; text-align: center; max-width: 600px;">
    <div style="font-size: 4rem; margin-bottom: 1rem;">🔍</div>
    <h1 style="font-size: 2.5rem; font-weight: 800; color: #0f172a; margin-bottom: 1rem;">
      Página no encontrada
    </h1>
    <p style="color: #64748b; font-size: 1.1rem; line-height: 1.6; margin-bottom: 2rem;">
      Lo sentimos, el enlace al que intentas acceder no existe o ha sido reubicado en el nuevo archivo estático.
    </p>
    <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
      <a href="/" class="btn-primary">
        Ir a la portada
      </a>
      <a href="/articulos" class="btn-secondary">
        Buscar en el archivo
      </a>
    </div>
  </div>
</Layout>
